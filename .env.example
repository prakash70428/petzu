# Copy this file to .env and fill in real values. .env is already
# git-ignored — never commit real credentials.

# --- Phase 0: Backend Foundation ------------------------------------------
# MongoDB Atlas connection string (Database > Connect > Drivers). Example shape:
# mongodb+srv://user:password@cluster.mongodb.net/petzu?retryWrites=true&w=majority
DATABASE_URL=

# --- Phase 2: Knowledge-base admin access ----------------------------------
# Comma-separated allowlist of staff emails permitted to write to the
# knowledge base (and, from Phase 4 on, see the CRM/admin dashboard pages).
# Minimal stand-in for real RBAC — see lib/auth/is-staff.ts and
# PHASE-2-2-KNOWLEDGE-BASE.md. Set this to your own email to try the admin
# page at /dashboard/admin/knowledge.
# ADMIN_EMAILS=

# --- Phase 3: AI Chatbot ----------------------------------------------------
# Get a key at console.anthropic.com. Without it, the chat widget still
# works end-to-end but replies with a "not configured" message instead of
# calling Claude — see lib/ai/anthropic-client.ts.
# ANTHROPIC_API_KEY=

# --- Phase 5: Automated Communication (Email + SMS) -------------------------
# Email — resend.com. Without a key, sends log to MessageLog as QUEUED
# instead of throwing (see lib/comms/adapters/email-resend.ts).
# RESEND_API_KEY=
# RESEND_FROM_EMAIL="PetZu <onboarding@resend.dev>"
#
# SMS — MSG91 (control.msg91.com). India SMS legally requires a
# DLT-registered template; see lib/comms/adapters/sms-msg91.ts for why the
# request shape here is illustrative until you have one.
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=

# --- Phase 5/6: WhatsApp Business (Meta Cloud API) ---------------------------
# developers.facebook.com/apps → your app → WhatsApp → API Setup.
# WHATSAPP_ACCESS_TOKEN / WHATSAPP_PHONE_NUMBER_ID are for sending (Phase 5:
# pre-approved templates only; Phase 6: also free-form replies inside a 24h
# session window). WHATSAPP_WEBHOOK_VERIFY_TOKEN is a string YOU make up and
# enter in Meta's webhook setup UI — the app/api/whatsapp/webhook route
# checks it matches on Meta's one-time verification handshake.
# WHATSAPP_APP_SECRET signs inbound webhook payloads (X-Hub-Signature-256);
# without it, app/api/whatsapp/webhook/route.ts accepts requests unverified
# — fine for local testing, not for a real deployment. See
# "Signature verification is opt-in until configured" in
# PHASE-2-6-WHATSAPP.md.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
